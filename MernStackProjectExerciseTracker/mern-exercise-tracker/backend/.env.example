NODE_ENV=production
PORT=5000
ATLAS_URI=your_mongodb_connection_string
AUTH_TOKEN_SECRET=use_a_long_random_secret_at_least_32_characters
CLIENT_URL=https://your-vercel-app.vercel.app
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite
GEMINI_ENABLE_GOOGLE_SEARCH=true
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
XTRACKER_PRO_MONTHLY_PRICE_INR=149
XTRACKER_PRO_YEARLY_PRICE_INR=999
XTRACKER_PRO_MONTHLY_AI_TOKENS=150000
XTRACKER_PRO_YEARLY_AI_TOKENS=300000
